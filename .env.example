# ── 음성 백엔드 (Hugging Face) ─────────────────────────────────────
# 한국어 인식. 이 값은 검증 없이 백엔드로 그대로 전달됩니다.
REALTIME_TRANSCRIPTION_LANGUAGE=ko

# deployed = 허깅페이스 제공 서버 (API 키 불필요, 기본값)
# local    = 직접 띄운 speech-to-speech 서버 사용
HF_REALTIME_CONNECTION_MODE=deployed
# HF_REALTIME_WS_URL=ws://127.0.0.1:8765/v1/realtime

# 비공개 Space 툴을 쓸 때만 필요
HF_TOKEN=

# ── 프로필 / 외부 툴 ──────────────────────────────────────────────
REACHY_MINI_CUSTOM_PROFILE=secretary_ko
REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=./profiles
REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=./external_tools
AUTOLOAD_EXTERNAL_TOOLS=1

# 비서는 하루 종일 켜져 있어야 하므로 자동 종료를 끕니다
REACHY_MINI_APP_TIMEOUT_MINUTES=0

# ── 비서 툴 ───────────────────────────────────────────────────────
# ask_claude 용. https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# 일정 해석 기준 시간대
REACHY_SECRETARY_TZ=Asia/Seoul

# credentials.json / token.json 위치 (기본: ~/.local/share/reachy_secretary_ko)
# REACHY_SECRETARY_GOOGLE_DIR=/home/pi/.local/share/reachy_secretary_ko
